; function: Test.example
bb0:
    %v1 = literal i64 1  // @owned Int64
    %v2 = struct Test.Handle { .0: %v1 }  // @owned Test.Handle
    %v3 = uninit Test.Handle  // @owned Pointer[Test.Handle]
    store_init %v3, %v2
    %v4 = uninit Bool  // @owned Pointer[Bool]
    %v5 = literal true  // @owned Bool
    store_init %v4, %v5
    branch %v0, bb1(%v3, %v4), bb2(%v3, %v4)

bb1(%v6: @owned Pointer[Test.Handle], %v7: @owned Pointer[Bool]):
    %v10 = take %v6, Test.Handle  // @owned Test.Handle
    %v11 = literal false  // @owned Bool
    store_assign %v4, %v11
    %v12 = call Test.consume(%v10)  // @owned ()
    %v13 = literal ()  // @owned ()
    destroy_value %v12
    jump bb3(%v13, %v6, %v7)

bb2(%v8: @owned Pointer[Test.Handle], %v9: @owned Pointer[Bool]):
