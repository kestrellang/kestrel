bb3(%v15: @owned (), %v16: @owned Pointer[Test.Handle], %v17: @owned Pointer[Bool]):
    %v18 = load %v4  // @owned Bool
    branch %v18, bb4(%v16, %v17, %v15, %v18), bb5(%v16, %v17, %v15, %v18)

bb4(%v19: @owned Pointer[Test.Handle], %v20: @owned Pointer[Bool], %v21: @owned (), %v22: @owned Bool):
