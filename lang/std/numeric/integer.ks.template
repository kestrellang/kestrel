        match self.powChecked(exponent) {
            .Some(value) => value,
{{IF_SIGNED}}
            .None => if self < 0 and exponent % 2 == 1 { {{TYPE_NAME}}.minValue } else { {{TYPE_NAME}}.maxValue }
{{ELSE}}
            .None => {{TYPE_NAME}}.maxValue
{{END_IF}}
        }
    }

    /// Greatest common divisor via Euclidean algorithm. For signed types
    /// the inputs are taken absolute first; the result is always non-negative.
    ///
    /// # Examples
    ///
    /// ```
    /// (12).gcd(8);   // 4
    /// (17).gcd(5);   // 1   (coprime)
    /// (-12).gcd(8);  // 4
