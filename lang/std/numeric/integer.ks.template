    /// ```
    /// (4).lcm(6);   // 12
    /// (3).lcm(5);   // 15
    /// (0).lcm(7);   // 0
    /// ```
    public func lcm(other: {{TYPE_NAME}}) -> {{TYPE_NAME}} {
        if self == {{TYPE_NAME}}.zero or other == {{TYPE_NAME}}.zero {
            return {{TYPE_NAME}}.zero
