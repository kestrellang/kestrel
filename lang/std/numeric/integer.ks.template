    /// Clamps `self` into `[min, max]`.
    ///
    /// # Errors
    ///
    /// Panics with `"clamp: min must be <= max"` when `min > max`.
    ///
    /// # Examples
    ///
    /// ```
    /// (5).clamp(0, 10);    // 5
    /// (-5).clamp(0, 10);   // 0
    /// (15).clamp(0, 10);   // 10
    /// ```
    public func clamp(min: {{TYPE_NAME}}, max: {{TYPE_NAME}}) -> {{TYPE_NAME}} {
        if min > max {
            fatalError("clamp: min must be <= max")
        }
        if self < min { min }
        else if self > max { max }
        else { self }
    }

