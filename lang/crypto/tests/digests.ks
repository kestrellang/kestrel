// Digest known answers across lengths that straddle block boundaries:
// SHA-1, SHA-2 (224/256/384/512/512-256), SHA-3, SHAKE128/256, BLAKE3 and
// HMAC over them. Expected values come from Python hashlib / hmac and the
// BLAKE3 C reference (portable build), generated over the same `pattern(n)`.

module crypto_tests_digests

import crypto.digest.(Digest, DigestOutput, SHA1, SHA224, SHA256, SHA384, SHA512, SHA512_256, SHA3_224, SHA3_256, SHA3_384, SHA3_512, BLAKE3, SHAKE128, SHAKE256)
import crypto.mac.(HMAC)
import crypto.key.(SymmetricKey)

func pattern(n: Int64) -> Array[UInt8] {
    var out: [UInt8] = [];
    for i in 0..<n { out.append(UInt8(from: i % 251)); }
    out
}

// Three updates at uneven split points, to cross block boundaries mid-update.
func incremental[H](n: Int64) -> DigestOutput where H: Digest {
    let data = pattern(n);
    let a = n / 3;
    let b = (2 * n) / 3 + 1;
    var h = H();
    h.update(data.asSlice().prefix(a));
    h.update(data.asSlice().drop(first: a).prefix(b - a));
    h.update(data.asSlice().drop(first: b));
    h.finalize()
}

func check(name: String, got: String, want: String) {
    if got == want { print("PASS \(name)\n"); } else { print("FAIL \(name)\n  got  \(got)\n  want \(want)\n"); }
}

@main
func main() {
    check("SHA1 len 0", SHA1.hash(pattern(0)).hexString, "da39a3ee5e6b4b0d3255bfef95601890afd80709");
    check("SHA1 len 1", SHA1.hash(pattern(1)).hexString, "5ba93c9db0cff93f52b521d7420e43f6eda2784f");
    check("SHA1 len 3", SHA1.hash(pattern(3)).hexString, "0c7a623fd2bbc05b06423be359e4021d36e721ad");
    check("SHA1 len 3 split", incremental[SHA1](3).hexString, "0c7a623fd2bbc05b06423be359e4021d36e721ad");
    check("SHA1 len 55", SHA1.hash(pattern(55)).hexString, "8ae2d46729cfe68ff927af5eec9c7d1b66d65ac2");
