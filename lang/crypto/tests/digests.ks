    check("SHAKE128 finalize twice", incSHAKE128.finalize(outputLength: 64).expect("s").hexString, "ed9a5f1ed895f8f7cbad5bf512be2d884ffc10ee917ab8d4188b846b8063f5334c84b81305d237c17be1f2149a09c0bc2a0cac85cfe50337b3294f6930db2518");
