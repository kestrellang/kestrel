// Password hashing: Argon2id (vectors from `openssl kdf ... ARGON2ID`),
// scrypt (RFC 7914 and Python hashlib.scrypt), PBKDF2, bcrypt (hashes made
// and checked with `htpasswd -B`, which writes `$2y$`), and PasswordHash's
// PHC / `$2b$` encoding, parsing, rejection and rehash rules.

module crypto_tests_passwords

import crypto.kdf.(Scrypt, Argon2id)
import crypto.digest.(DigestOutput)
import crypto.error.(CryptoError)
import crypto.password.(PasswordHash, PasswordScheme)

func hex(b: Array[UInt8]) -> String { DigestOutput(bytes: b).hexString }

func check(name: String, got: String, want: String) {
    if got == want { print("PASS \(name)\n"); } else { print("FAIL \(name)\n  got  \(got)\n  want \(want)\n"); }
}

@main
func main() {
    check("scrypt ln=4 r=1 p=1 dk=64", hex(Scrypt.deriveKey("".asByteSlice(), salt: "".asByteSlice(), logN: 4, blockSize: 1, parallelism: 1, length: 64).expect("s").bytes), "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906");
    check("scrypt ln=10 r=8 p=16 dk=64", hex(Scrypt.deriveKey("password".asByteSlice(), salt: "NaCl".asByteSlice(), logN: 10, blockSize: 8, parallelism: 16, length: 64).expect("s").bytes), "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640");
    check("scrypt ln=14 r=8 p=1 dk=64", hex(Scrypt.deriveKey("pleaseletmein".asByteSlice(), salt: "SodiumChloride".asByteSlice(), logN: 14, blockSize: 8, parallelism: 1, length: 64).expect("s").bytes), "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887");
    check("scrypt ln=5 r=2 p=3 dk=17", hex(Scrypt.deriveKey("pw".asByteSlice(), salt: "saltsalt".asByteSlice(), logN: 5, blockSize: 2, parallelism: 3, length: 17).expect("s").bytes), "bf30523795aff783f5693a41171dfc97d3");
    check("scrypt ln=3 r=1 p=1 dk=100", hex(Scrypt.deriveKey("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx".asByteSlice(), salt: "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy".asByteSlice(), logN: 3, blockSize: 1, parallelism: 1, length: 100).expect("s").bytes), "ffba983821ff2d4fbd441818dc20d3433b039889581fbfcb4d4b7cf0716df494001a7a2cabeb3c15810144fb627d56c6a5e9d39fa21c78e982a03146ab46752467f265458e6b89c7dc1069f19845be623d2ba0b59ff092a025215b4a94398e7d24108d7c");
    match Scrypt.deriveKey("p".asByteSlice(), salt: "s".asByteSlice(), logN: 0, blockSize: 8, parallelism: 1, length: 32) { .Err(.InvalidParameter) => { print("PASS scrypt logN 0 -> InvalidParameter\n"); }, _ => { print("FAIL scrypt logN 0\n"); } }
    match Scrypt.deriveKey("p".asByteSlice(), salt: "s".asByteSlice(), logN: 4, blockSize: 0, parallelism: 1, length: 32) { .Err(.InvalidParameter) => { print("PASS scrypt r 0 -> InvalidParameter\n"); }, _ => { print("FAIL scrypt r 0\n"); } }
    check("argon2id m=8 t=1 p=1 len=32 pw='password'", hex(Argon2id.deriveKey("password".asByteSlice(), salt: "somesalt".asByteSlice(), memory: 8, iterations: 1, parallelism: 1, length: 32).expect("a").bytes), "f137f8e186a403a679ccd0606e5ab5dcdafe43c1640855ac8c6e33e9bd63eeb3");
    check("argon2id m=32 t=3 p=4 len=32 pw='password'", hex(Argon2id.deriveKey("password".asByteSlice(), salt: "somesalt".asByteSlice(), memory: 32, iterations: 3, parallelism: 4, length: 32).expect("a").bytes), "bb0cc80a3e671149526915418c6eefe761bb19d5d2d567a017703e0cea6ab05c");
    check("argon2id m=64 t=2 p=1 len=32 pw='password'", hex(Argon2id.deriveKey("password".asByteSlice(), salt: "somesalt".asByteSlice(), memory: 64, iterations: 2, parallelism: 1, length: 32).expect("a").bytes), "16a1a498734609dd01456da406de9f3d9da93e6c86c300a12fc1465214ce4922");
    check("argon2id m=100 t=2 p=2 len=32 pw='hunter2'", hex(Argon2id.deriveKey("hunter2".asByteSlice(), salt: "saltsaltsalt".asByteSlice(), memory: 100, iterations: 2, parallelism: 2, length: 32).expect("a").bytes), "c8ad08d64e8695d997e0509d20174d08a97e975fe479d0f9f5e36e88567ba4d9");
    check("argon2id m=1024 t=1 p=1 len=32 pw='password'", hex(Argon2id.deriveKey("password".asByteSlice(), salt: "somesalt".asByteSlice(), memory: 1024, iterations: 1, parallelism: 1, length: 32).expect("a").bytes), "c8e9aedc956f6a7dff0a4d42940df628623f328ea1235005abac933c57093e23");
    check("argon2id m=600 t=2 p=3 len=16 pw='password'", hex(Argon2id.deriveKey("password".asByteSlice(), salt: "somesalt".asByteSlice(), memory: 600, iterations: 2, parallelism: 3, length: 16).expect("a").bytes), "2f33c1a4b49fac0902851751c248ed1d");
    check("argon2id m=16 t=1 p=1 len=4 pw='pw'", hex(Argon2id.deriveKey("pw".asByteSlice(), salt: "saltsalt".asByteSlice(), memory: 16, iterations: 1, parallelism: 1, length: 4).expect("a").bytes), "107dadd1");
    check("argon2id m=16 t=1 p=1 len=64 pw='pw'", hex(Argon2id.deriveKey("pw".asByteSlice(), salt: "saltsalt".asByteSlice(), memory: 16, iterations: 1, parallelism: 1, length: 64).expect("a").bytes), "4a88e2c4cbe3847770618f29dbd557b4b7dcfc46d3d8e7dd87c1011cc086882a12e03aed4e5aaa2702d6549522ffc51293a2a3d6ddfa005f5657c5cfbdfcaa78");
    check("argon2id m=16 t=1 p=1 len=65 pw='pw'", hex(Argon2id.deriveKey("pw".asByteSlice(), salt: "saltsalt".asByteSlice(), memory: 16, iterations: 1, parallelism: 1, length: 65).expect("a").bytes), "71e7540bc5ed33d2a3c9bd5f96d8c77508b05b66ad07d4be6c13ddedc884e956e24d8fc37ab5dab8ae4b424bc6e5df9835b8b097463df6539de436c204d8115581");
    check("argon2id m=16 t=1 p=1 len=100 pw='pw'", hex(Argon2id.deriveKey("pw".asByteSlice(), salt: "saltsalt".asByteSlice(), memory: 16, iterations: 1, parallelism: 1, length: 100).expect("a").bytes), "ffd8f32ab13a7b6f8d38f8a9160d5b9a03f7ae9469ae2bcf1c4ad76ac6cd410275128e47fc63740e1358162c2a7662077c09b16919012496a0d331a01cd7ec0f9ebf4e77d845044af68435b31d9c4e57c40d4a2ed2ac66c2c7622efda830984ef8546908");
    check("argon2id m=16 t=2 p=1 len=32 pw=''", hex(Argon2id.deriveKey("".asByteSlice(), salt: "saltsalt".asByteSlice(), memory: 16, iterations: 2, parallelism: 1, length: 32).expect("a").bytes), "b4a42b3f7643ae2989a7ce665c8c05ee060b18b3dde1d636945e133b11c358cc");
    match Argon2id.deriveKey("p".asByteSlice(), salt: "saltsalt".asByteSlice(), memory: 7, iterations: 1, parallelism: 1, length: 32) { .Err(.InvalidParameter) => { print("PASS argon2 m<8p -> InvalidParameter\n"); }, _ => { print("FAIL argon2 m<8p\n"); } }
    match Argon2id.deriveKey("p".asByteSlice(), salt: "short".asByteSlice(), memory: 64, iterations: 1, parallelism: 1, length: 32) { .Err(.InvalidLength) => { print("PASS argon2 short salt -> InvalidLength\n"); }, _ => { print("FAIL argon2 short salt\n"); } }
    match PasswordHash(encoded: "$2y$04$yon/rJEYgXg7O/dAZDAv8.K/NqcXjPw.s071a4RhjjTUDWQZfD47O") { some b => { check("bcrypt htpasswd cost 4 verify 'secret'", "\(b.verify("secret"))", "true"); check("bcrypt htpasswd wrong", "\(b.verify("secretx"))", "false"); check("bcrypt reencode 2b", b.encoded, "$2b$04$yon/rJEYgXg7O/dAZDAv8.K/NqcXjPw.s071a4RhjjTUDWQZfD47O"); }, null => { print("FAIL bcrypt parse 4\n"); } }
    match PasswordHash(encoded: "$2y$05$jK2tcUXa/xfVxqJxiApQpePKajFPJ3x5ausp2hZt72wnBIvYrlM.q") { some b => { check("bcrypt htpasswd cost 5 verify 'correct hors'", "\(b.verify("correct horse battery staple"))", "true"); check("bcrypt htpasswd wrong", "\(b.verify("correct horse battery staplex"))", "false"); check("bcrypt reencode 2b", b.encoded, "$2b$05$jK2tcUXa/xfVxqJxiApQpePKajFPJ3x5ausp2hZt72wnBIvYrlM.q"); }, null => { print("FAIL bcrypt parse 5\n"); } }
    match PasswordHash(encoded: "$2y$04$tTf1EmZSMzg9cRcFUE.aC.APT1bS4G8jAO1HqachuuQuYtfN7m3Y2") { some b => { check("bcrypt htpasswd cost 4 verify 'pässwörd ☃'", "\(b.verify("pässwörd ☃"))", "true"); check("bcrypt htpasswd wrong", "\(b.verify("pässwörd ☃x"))", "false"); check("bcrypt reencode 2b", b.encoded, "$2b$04$tTf1EmZSMzg9cRcFUE.aC.APT1bS4G8jAO1HqachuuQuYtfN7m3Y2"); }, null => { print("FAIL bcrypt parse 4\n"); } }
    match PasswordHash(encoded: "$2y$04$Pm88xkkq.qVDUI8mqHc0o.sWIEeQYINuwzUqMqS9RLuNr04KS5exS") { some b => { check("bcrypt htpasswd cost 4 verify 'aaaaaaaaaaaa'", "\(b.verify("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))", "true"); check("bcrypt htpasswd wrong", "\(b.verify("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax"))", "true"); check("bcrypt reencode 2b", b.encoded, "$2b$04$Pm88xkkq.qVDUI8mqHc0o.sWIEeQYINuwzUqMqS9RLuNr04KS5exS"); }, null => { print("FAIL bcrypt parse 4\n"); } }
    check("bcrypt 72-byte prefix matches long password", "\(PasswordHash(encoded: "$2y$04$Pm88xkkq.qVDUI8mqHc0o.sWIEeQYINuwzUqMqS9RLuNr04KS5exS").expect("b").verify("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))", "true");
    match PasswordHash(encoded: "$argon2id$v=19$m=64,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$Gpj7qOY5RCXJvcMzqcdQqvgR3wcPX7SleI4c9NtXk6E") { some a => { check("argon2id phc verify m=64", "\(a.verify("password"))", "true"); check("argon2id phc wrong", "\(a.verify("nope"))", "false"); check("argon2id phc reencode", a.encoded, "$argon2id$v=19$m=64,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$Gpj7qOY5RCXJvcMzqcdQqvgR3wcPX7SleI4c9NtXk6E"); check("argon2id phc scheme", "\(a.scheme == .Argon2id(memory: 64, iterations: 2, parallelism: 1))", "true"); }, null => { print("FAIL argon2id phc parse\n"); } }
    match PasswordHash(encoded: "$argon2id$v=19$m=48,t=3,p=2$c2FsdHNhbHRzYWx0c2FsdA$JaVHCPnSpJhyNOPTAhPoixn6CnlZMWRoHu24xe7ETbM") { some a => { check("argon2id phc verify m=48", "\(a.verify("hunter2"))", "true"); check("argon2id phc wrong", "\(a.verify("nope"))", "false"); check("argon2id phc reencode", a.encoded, "$argon2id$v=19$m=48,t=3,p=2$c2FsdHNhbHRzYWx0c2FsdA$JaVHCPnSpJhyNOPTAhPoixn6CnlZMWRoHu24xe7ETbM"); check("argon2id phc scheme", "\(a.scheme == .Argon2id(memory: 48, iterations: 3, parallelism: 2))", "true"); }, null => { print("FAIL argon2id phc parse\n"); } }
    match PasswordHash(encoded: "$scrypt$ln=10,r=8,p=1$MDEyMzQ1Njc4OWFiY2RlZg$ZEBCzLptWM7dhpNJDU2HbQ945ovKHmVEozHkePPbSqw") { some c => { check("scrypt phc verify ln=10", "\(c.verify("password"))", "true"); check("scrypt phc wrong", "\(c.verify("nope"))", "false"); check("scrypt phc reencode", c.encoded, "$scrypt$ln=10,r=8,p=1$MDEyMzQ1Njc4OWFiY2RlZg$ZEBCzLptWM7dhpNJDU2HbQ945ovKHmVEozHkePPbSqw"); }, null => { print("FAIL scrypt phc parse\n"); } }
    match PasswordHash(encoded: "$scrypt$ln=6,r=4,p=2$c2FsdHNhbHRzYWx0c2FsdA$9a9tL8uW81MWnhhQt2KC9tkAqW0cZ8uDj+j5dAbKVVI") { some c => { check("scrypt phc verify ln=6", "\(c.verify("pw"))", "true"); check("scrypt phc wrong", "\(c.verify("nope"))", "false"); check("scrypt phc reencode", c.encoded, "$scrypt$ln=6,r=4,p=2$c2FsdHNhbHRzYWx0c2FsdA$9a9tL8uW81MWnhhQt2KC9tkAqW0cZ8uDj+j5dAbKVVI"); }, null => { print("FAIL scrypt phc parse\n"); } }
    print("OUT argon2id \(PasswordHash.hash("kestrel pw", with: .Argon2id(memory: 64, iterations: 2, parallelism: 2)).expect("a").encoded)\n");
    print("OUT scrypt \(PasswordHash.hash("kestrel pw", with: .Scrypt(logN: 8, blockSize: 8, parallelism: 1)).expect("s").encoded)\n");
    print("OUT bcrypt \(PasswordHash.hash("kestrel pw", with: .Bcrypt(cost: 5)).expect("b").encoded)\n");
    let h12 = PasswordHash.hash("roundtrip", with: .Argon2id(memory: 64, iterations: 1, parallelism: 1)).expect("h"); check("roundtrip .Argon2id", "\(PasswordHash(encoded: h12.encoded).expect("p").verify("roundtrip")) \(h12.needsRehash())", "true true");
    let h13 = PasswordHash.hash("roundtrip", with: .Scrypt(logN: 6, blockSize: 8, parallelism: 1)).expect("h"); check("roundtrip .Scrypt(l", "\(PasswordHash(encoded: h13.encoded).expect("p").verify("roundtrip")) \(h13.needsRehash())", "true true");
    let h14 = PasswordHash.hash("roundtrip", with: .PBKDF2(iterations: 100)).expect("h"); check("roundtrip .PBKDF2(i", "\(PasswordHash(encoded: h14.encoded).expect("p").verify("roundtrip")) \(h14.needsRehash())", "true true");
    let h15 = PasswordHash.hash("roundtrip", with: .Bcrypt(cost: 4)).expect("h"); check("roundtrip .Bcrypt(c", "\(PasswordHash(encoded: h15.encoded).expect("p").verify("roundtrip")) \(h15.needsRehash())", "true true");
    check("recommended needsRehash false", "\(PasswordHash(encoded: PasswordHash.hash("x", with: PasswordScheme.recommended).expect("r").encoded).expect("p").needsRehash())", "false");
    match PasswordHash.hash("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", with: .Bcrypt(cost: 4)) { .Err(.InvalidLength) => { print("PASS bcrypt 73 bytes -> InvalidLength\n"); }, _ => { print("FAIL bcrypt 73\n"); } }
    check("bcrypt 72 bytes ok", "\(PasswordHash.hash("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", with: .Bcrypt(cost: 4)).isOk())", "true");
    match PasswordHash.hash("x", with: .Bcrypt(cost: 3)) { .Err(.InvalidParameter) => { print("PASS bcrypt cost 3 -> InvalidParameter\n"); }, _ => { print("FAIL bcrypt cost 3\n"); } }
    check("reject $argon2id$m=64,t=2,p=1$c", "\(PasswordHash(encoded: "$argon2id$m=64,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$AAAA").isSome)", "false");
    check("reject $argon2id$v=19$m=64,t=2$", "\(PasswordHash(encoded: "$argon2id$v=19$m=64,t=2$c29tZXNhbHRzb21lc2FsdA$AAAA").isSome)", "false");
    check("reject $argon2id$v=19$m=64,t=2,", "\(PasswordHash(encoded: "$argon2id$v=19$m=64,t=2,p=1,x=3$c29tZXNhbHRzb21lc2FsdA$AAAA").isSome)", "false");
    check("reject $scrypt$ln=6,r=8$c29tZXN", "\(PasswordHash(encoded: "$scrypt$ln=6,r=8$c29tZXNhbHRzb21lc2FsdA$AAAA").isSome)", "false");
    check("reject $2b$03$.................", "\(PasswordHash(encoded: "$2b$03$.....................................................").isSome)", "false");
    check("reject $2b$12$.................", "\(PasswordHash(encoded: "$2b$12$....................................................").isSome)", "false");
    check("reject $2x$10$.................", "\(PasswordHash(encoded: "$2x$10$.....................................................").isSome)", "false");
}
