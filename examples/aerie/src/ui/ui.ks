        32 => 16.00,
        33 => 8.00,
        34 => 16.00,
        35 => 24.00,
        36 => 24.00,
        37 => 24.00,
        38 => 24.00,
        39 => 8.00,
        40 => 12.00,
        41 => 12.00,
        42 => 24.00,
        43 => 24.00,
