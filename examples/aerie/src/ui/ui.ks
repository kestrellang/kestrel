        46 => 8.00,
        47 => 24.00,
        48 => 24.00,
        49 => 24.00,
        50 => 24.00,
        51 => 24.00,
        52 => 24.00,
        53 => 24.00,
        54 => 24.00,
        55 => 24.00,
        56 => 24.00,
        57 => 24.00,
        58 => 8.00,
        59 => 12.00,
        60 => 20.00,
        61 => 20.00,
        62 => 20.00,
        63 => 24.00,
        64 => 24.00,
        65 => 24.00,
        66 => 24.00,
        67 => 24.00,
        68 => 24.00,
        69 => 24.00,
        70 => 24.00,
